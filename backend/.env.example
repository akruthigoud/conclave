# Copy to backend/.env — every value has a working default, nothing is required.

# "demo" runs entirely with real web search + template synthesis, zero API key.
# Switch to "groq" or "openai" for LLM-based planning, critique, and writing.
LLM_PROVIDER=demo

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Graph tuning ---
MAX_SUBTASKS=4
MAX_CRITIQUE_ROUNDS=2
MAX_SEARCH_RESULTS_PER_SUBTASK=4
